FROM wordpress:cli

USER root
RUN set -eux; \
    if command -v apk >/dev/null 2>&1; then \
        apk add --no-cache jq; \
    elif command -v apt-get >/dev/null 2>&1; then \
        apt-get update; \
        apt-get install -y --no-install-recommends jq; \
        rm -rf /var/lib/apt/lists/*; \
    else \
        echo "ERROR: No supported package manager found (apk or apt-get)." >&2; \
        exit 1; \
    fi

USER www-data