FROM wordpress:cli

USER root
ARG KUBECTL_VERSION=""

RUN set -eux; \
    # --- install jq + curl + ca-certificates ---
    if command -v apk >/dev/null 2>&1; then \
      apk add --no-cache jq curl ca-certificates; \
    elif command -v apt-get >/dev/null 2>&1; then \
      apt-get update; \
      apt-get install -y --no-install-recommends jq curl ca-certificates; \
      rm -rf /var/lib/apt/lists/*; \
    else \
      echo "ERROR: No supported package manager found (apk or apt-get)." >&2; \
      exit 1; \
    fi; \
    \
    # --- pick kubectl version: explicit ARG or latest stable ---
    if [ -z "${KUBECTL_VERSION:-}" ]; then \
      KUBECTL_VERSION="$(curl -L -s https://dl.k8s.io/release/stable.txt)"; \
    fi; \
    echo "Installing kubectl ${KUBECTL_VERSION}"; \
    \
    # --- map architecture for download (amd64 / arm64) ---
    ARCH="$(uname -m)"; \
    case "${ARCH}" in \
      x86_64) ARCH=amd64 ;; \
      aarch64|arm64) ARCH=arm64 ;; \
      *) echo "ERROR: Unsupported arch: ${ARCH}" >&2; exit 1 ;; \
    esac; \
    \
    # --- download kubectl from official Kubernetes release bucket ---
    curl -L -o /usr/local/bin/kubectl \
      "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${ARCH}/kubectl"; \
    chmod +x /usr/local/bin/kubectl; \
    \
    # quick sanity check so bad downloads fail the build
    kubectl version --client --output=yaml >/dev/null 2>&1

USER www-data